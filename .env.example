# Copy to .env and fill in. NEVER commit .env.
RELAY_URL=wss://203.0.113.10:8443/ws/agent
AGENT_TOKEN=REPLACE_WITH_SAME_AGENT_TOKEN_AS_RELAY
CA_FILE=certs/ca.pem

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3-vl:8b
# Context window. 4096 (mặc định Ollama) quá nhỏ; thinking dài ăn hết -> nâng cao.
OLLAMA_NUM_CTX=12288
# Số ảnh màn hình gần nhất giữ trong hội thoại (ảnh cũ bị lược bỏ).
KEEP_IMAGES=2
# true = qwen3-vl suy nghĩ (thinking) - chậm và dễ không ra tool_call; để false.
OLLAMA_THINK=false
# true = thêm "/no_think" vào tin nhắn user (tắt thinking đúng kiểu Qwen3).
NO_THINK=true
# true = tinh chỉnh click bằng phóng to (chính xác hơn, thêm 1 lần gọi LLM/click).
REFINE_CLICK=true
# true = lưu ảnh mỗi bước (screenshot, lưới, các cấp locate, điểm đã bấm) để kiểm tra.
SAVE_IMAGES=true
IMAGE_DIR=debug_images
# OCR Set-of-Mark: định vị theo chữ (cần paddleocr+paddlepaddle). Không ra thì
# tự fallback sang locate 3x3.
OCR_ENABLE=true
# auto = thử PaddleOCR trước, không có thì EasyOCR. Hoặc ghi rõ: paddle | easyocr
OCR_BACKEND=auto
OCR_LANG=vi
# Trong lưới 3x3: chạy OCR song song với LLM khi đã tách >= số lần này (vùng đủ nhỏ).
OCR_PARALLEL_MIN_SPLITS=2
# Set-of-Mark: trước khi dùng lưới 3x3, đánh số các hộp (chữ OCR + hộp UI do OpenCV
# phát hiện, kể cả ô trống/nút không chữ) và để model chọn số. Bắt được phần tử
# không có chữ mà keyword không khớp. OpenCV đi kèm paddleocr nên thường đã có.
MARKS_ENABLE=true
# Số vùng tối đa vẽ lên ảnh (để số còn đọc được); ưu tiên vùng gần tâm khu vực tìm.
MARKS_MAX=40
# (C) UIAutomation: trước khi dùng vision, hỏi PC toạ độ thật của phần tử theo tên
# (lệnh 'uia' trong MomoBleAgent.ps1). Chính xác, không cần quy đổi ảnh. Không
# thấy (canvas/không expose a11y) thì tự rơi về OCR/marks/lưới. CẦN flash lại ESP
# (ai_link.c thêm lệnh uia) + chạy lại MomoBleAgent.ps1 bản mới.
UIA_ENABLE=true
# Thời gian chờ PC tra cây UIA (lần đầu Chrome dựng a11y tree có thể hơi lâu).
UIA_TIMEOUT=8
# UIA Set-of-Mark: khi tra theo tên/loại không ra, PC đánh số MỌI component tương
# tác lên ảnh (hộp chính xác từ a11y), LLM chọn số, PC tự tra toạ độ. Rất hợp UI web.
UIA_MARKS_ENABLE=true
# Hybrid grounding (phương án ①): khớp chữ OCR RẤT chắc (>= ngưỡng này) thì bấm
# NGAY, trước UI-TARS. Phần tử có chữ ("Aa", "Gửi") OCR đọc chính xác hơn VLM trỏ;
# UI-TARS lo phần không chữ / icon. Hạ xuống (vd 0.85) nếu muốn OCR thắng nhiều hơn.
OCR_EXACT_MIN=0.9
# true = phần tử KHÔNG có keywords thì hỏi UI-TARS trước (cần UITARS_ENABLE=true). Phần
# tử có keywords luôn thử OCR trước. false = luôn để OCR-exact đứng trước UI-TARS.
UITARS_BEFORE_OCR=true
# (B) UI-TARS grounding: qwen lo instruction/hội thoại, UI-TARS (chuyên GUI) lo
# "bấm vào đâu". Mỗi lần tap, gửi ảnh + mô tả phần tử cho UI-TARS -> toạ độ. Chỉ
# 1 model chạy 1 lúc: Ollama swap UI-TARS vào (vài giây, đẩy qwen ra) rồi swap qwen
# lại cho lượt lý luận sau. PHẢI tạo model trong Ollama trước (xem UI-TARS-SETUP.md)
# rồi đặt UITARS_MODEL = tag của nó. Để false cho tới khi đã pull/tạo xong model.
UITARS_ENABLE=false
UITARS_MODEL=ui-tars
# Context cho grounding (ít thôi, 1 ảnh + 1 câu).
UITARS_NUM_CTX=4096
# Chờ tối đa 1 lần gọi UI-TARS (gồm cả thời gian Ollama swap/nạp model).
UITARS_TIMEOUT=90
# Cạnh dài nhất của ảnh trước khi gửi (giữ toạ độ trong hệ mình kiểm soát).
UITARS_MAX_SIDE=1288
# true = gửi ảnh ĐÚNG cỡ màn hình thật -> UI-TARS trả thẳng toạ độ màn hình, khỏi
# quy đổi. RỦI RO: 1920x1080 (~2M px) có thể vượt ngân sách model -> model tự thu
# nhỏ bên trong -> toạ độ lệch. Chỉ bật nếu test thấy click chuẩn ở full res.
UITARS_FULLRES=false
# Quy ước toạ độ UI-TARS trả: image = pixel ảnh đã gửi | norm1000 = 0..1000 |
# auto = đoán. UI-TARS-1.5 dùng PIXEL tuyệt đối (như Qwen2.5-VL) nên hãy đặt
# 'image'. auto chỉ coi là norm1000 khi toạ độ vượt kích thước ảnh; toạ độ nhỏ
# dễ nhập nhằng -> chạy thử, xem chấm đỏ debug, rồi GHI CỐ ĐỊNH 'image'/'norm1000'.
UITARS_COORD=image
# Plan-and-execute: task nhiều bước (vd "tìm X rồi nhắn Y") được phân rã thành danh
# sách bước ở đầu task (1 lần gọi LLM, không tốn VRAM) rồi làm lần lượt. Task đơn
# giản / câu hỏi thường tự bỏ qua. Tắt = chạy thẳng không lập kế hoạch.
PLAN_ENABLE=true
# web_search: cho model tra Internet ngay trên máy chủ (không mở trình duyệt).
SEARCH_ENABLE=true
# ddgs = DuckDuckGo (không cần API key). tavily = Tavily API (ổn định hơn).
SEARCH_BACKEND=ddgs
# Vùng kết quả DuckDuckGo (vn-vi = Việt Nam/tiếng Việt). wt-wt = toàn cầu.
SEARCH_REGION=vn-vi
# Chỉ cần khi SEARCH_BACKEND=tavily:
TAVILY_API_KEY=
SEARCH_TIMEOUT=15
# Sau khi tìm, tự tải nội dung mấy trang đầu để trả lời chi tiết hơn.
SEARCH_FETCH=true
SEARCH_FETCH_TOP=2
SEARCH_FETCH_CHARS=2000
# true = log đầy đủ (không cắt bớt thinking/content + liệt kê hội thoại mỗi lượt).
AGENT_DEBUG=false
# true = gửi log của task về khung chat web (ngoài console Linux).
UI_LOGS=true
# Dùng lại ảnh/OCR vừa chụp trong bao lâu (giây). Tự xoá sau mỗi thao tác trên màn hình.
SCREEN_CACHE_TTL_SECONDS=6
OCR_CACHE_TTL_SECONDS=6

MAX_STEPS=20
# Ngữ cảnh nối tiếp: yêu cầu mới thấy tối đa CONTEXT_TURNS yêu cầu trước của CÙNG thiết
# bị trong CONTEXT_TTL_SECONDS giây. Chỉ giữ trong RAM. Gõ "bắt đầu lại" để xoá.
CONTEXT_TTL_SECONDS=900
CONTEXT_TURNS=3
CONTEXT_RESULT_CHARS=600
# Thời gian chờ người dùng trả lời ask_user (giây); không tính vào TASK_TIMEOUT_SECONDS.
CHOICE_TIMEOUT_SECONDS=180
TASK_TIMEOUT_SECONDS=300
# Thời gian tối đa cho MỖI lần gọi LLM. Ollama chạy CPU / đang tải model 8B có thể
# lâu; quá ngưỡng này thì báo lỗi thay vì treo vô hạn.
OLLAMA_TIMEOUT=180
MAX_RETRIES_PER_TOOL=2
DEVICE_CALL_TIMEOUT=10
